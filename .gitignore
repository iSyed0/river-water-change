# JRC source rasters: public downloads, about 920 MB. The rendered tiles in portal/tiles are kept.
/change/
/extent/
/occurrence/
/recurrence/
/seasonality/
/transitions/

# Downloads and build caches, about 1.7 GB; recreated by the scripts
/build/
/osm_src/

# Full-detail boundaries, about 600 MB: over GitHub's file limit. prepare_boundaries.py and prepare_admin_units.py read them.
/boundries/

# Earth Engine monthly exports (about 5 GB) and the monthly tiles made from them (about 480 MB, 62,000 files):
# too large for GitHub. prepare_timeline.py rebuilds the tiles from the exports. The yearly tiles (47 MB) are kept.
/ndma water monthly/
/portal/tiles/monthly/

# Rebuilt by prepare_water_types.py; the rendered tiles in portal/tiles are kept
/watertype/

# Not used by the portal
/rivers/

__pycache__/
*.pyc
desktop.ini

# Water source tiles, about 800 MB: rebuild with scripts/build_tiles.py --group river|flood|lakes
/portal/tiles/source/
